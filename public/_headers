# Security Headers for all pages
/*
  # Content Security Policy - Strict but functional for the app
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.danbooru.donmai.us https://danbooru.donmai.us; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: http:; connect-src 'self' https://cdn.danbooru.donmai.us https://danbooru.donmai.us https://api.deepl.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  # Prevent clickjacking
  X-Frame-Options: DENY
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff
  # Enable XSS protection
  X-XSS-Protection: 1; mode=block
  # Referrer policy for privacy
  Referrer-Policy: strict-origin-when-cross-origin
  # Permissions policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Strict Transport Security (HTTPS only)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Headers para archivos estáticos - Netlify maneja automáticamente la compresión
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  # Additional security for static assets
  Cross-Origin-Resource-Policy: cross-origin

/*.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  # Prevent execution in wrong context
  X-Content-Type-Options: nosniff

/*.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  # MIME type enforcement for CSS
  Content-Type: text/css

/index.html
  # Evitamos must-revalidate (no recomendado); max-age bajo y revalidación implícita
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  # Additional security for main page
  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Opener-Policy: same-origin

/data/*
  # Datos que cambian ocasionalmente: 1h + revalidación cada despliegue
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  # JSON data security
  Content-Type: application/json

# API endpoints security
/api/*
  # No caching for API responses
  Cache-Control: no-cache, no-store, must-revalidate
  # API-specific security headers
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY