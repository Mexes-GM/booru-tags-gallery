{
  "name": "booru-tags-gallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "cross-env NODE_ENV=development tsc && cross-env NODE_ENV=development vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "cross-env NODE_ENV=development vite preview",
    "type-check": "tsc --noEmit",
    "generate-fuse-index": "node scripts/generate-fuse-index.cjs",
    "fetch-tag-groups": "node scripts/fetch-tag-groups.cjs",
    "optimize": "node scripts/optimize-performance.js",
    "pre-production-check": "node scripts/pre-production-check.js",
    "verify-build": "node scripts/verify-build.js",
    "generate-sitemap": "node scripts/generate-sitemap.cjs",
    "build:production": "npm run type-check && npm run optimize && tsc && vite build --mode production && npm run verify-build",
    "build:production-force": "npm run optimize && tsc && vite build --mode production && npm run verify-build",
    "audit:production": "node scripts/audit-production.js",
    "deploy": "node deploy.cjs",
    "deploy:netlify": "netlify deploy --prod --dir=dist",
    "deploy:preview": "netlify deploy --dir=dist",
    "deploy:auto": "npm run deploy && npm run deploy:netlify",
    "dev:netlify": "netlify dev",
    "functions:serve": "netlify functions:serve --port 9999",
    "dev:vercel": "vercel dev"
  },
  "dependencies": {
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "axios": "^1.10.0",
    "fuse.js": "^7.1.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.540.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.6.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-router-dom": "^7.6.3",
    "react-window": "^1.8.11",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.5.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^11.0.1",
    "imagemin-webp": "^8.0.0",
    "netlify-cli": "^23.1.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.43.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-imagemin": "^0.6.1"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
