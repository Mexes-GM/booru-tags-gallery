{
  "name": "booru-tags-gallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/generate-sitemap.cjs --out dist && node scripts/verify-build.js",
    "lint": "eslint . --report-unused-disable-directives",
    "test": "vitest run",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "generate-fuse-index": "node scripts/generate-fuse-index.cjs",
    "sync-tags": "node scripts/sync-tags-from-supabase.mjs",
    "fetch-tag-groups": "node scripts/fetch-tag-groups.cjs",
    "pre-production-check": "node scripts/pre-production-check.js",
    "verify-build": "node scripts/verify-build.js",
    "generate-sitemap": "node scripts/generate-sitemap.cjs",
    "build:production": "npm run build && npm run verify-build",
    "audit:production": "node scripts/audit-production.js",
    "deploy": "node deploy.cjs",
    "deploy:netlify": "npx netlify-cli deploy --prod --dir=dist",
    "deploy:preview": "npx netlify-cli deploy --dir=dist",
    "deploy:auto": "npm run deploy && npm run deploy:netlify",
    "dev:netlify": "npx netlify-cli dev",
    "functions:serve": "npx netlify-cli functions:serve --port 9999",
    "dev:vercel": "vercel dev"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "axios": "^1.20.0",
    "dompurify": "^3.4.16",
    "fuse.js": "^7.1.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.540.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.43.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
