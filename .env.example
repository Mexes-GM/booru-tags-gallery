# DeepL Translation API Configuration
# Get your API key from https://www.deepl.com/pro-api
DEEPL_API_KEY=your_deepl_api_key_here

# Supabase (Booru Prompt Gallery) - used only by `npm run sync-tags` on your machine.
# Never prefix these with VITE_: they must not end up in the browser bundle.
# Alternatively: npm run sync-tags -- --env ../booru-prompt-gallery/.env.local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Public origin of the deployed site (no trailing slash), e.g. https://booru-tags.example.com
# Used at build time for canonical URLs, Open Graph and JSON-LD, and by `npm run generate-sitemap`.
# If unset, the app falls back to the URL the visitor is on and no sitemap is generated.
VITE_SITE_URL=
